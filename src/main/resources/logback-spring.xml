<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuracion de Logback:
  - Consola con colores en desarrollo.
  - Archivo de aplicacion con rotacion diaria (30 dias, maximo 1 GB).
  - Archivo separado para notificaciones (logger "NOTIFICACIONES").
  Los datos personales se enmascaran en el codigo (DatosSensibles) antes de llegar al log.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="logs"/>

    <property name="PATRON" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/citas-clinica.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/citas-clinica.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATRON}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="NOTIFICACIONES_ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/notificaciones.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/notificaciones.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>90</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${PATRON}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="NOTIFICACIONES" level="INFO" additivity="true">
        <appender-ref ref="NOTIFICACIONES_ARCHIVO"/>
    </logger>

    <logger name="pe.clinicasantaelena.citas" level="INFO"/>

    <springProfile name="dev">
        <logger name="pe.clinicasantaelena.citas" level="DEBUG"/>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLA"/>
        <appender-ref ref="ARCHIVO"/>
    </root>
</configuration>
